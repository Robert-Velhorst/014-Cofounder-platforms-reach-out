# Rebuild the exact stable Caddy source with patched stable Go/network modules.
# The upstream runtime image is retained for its certificate and filesystem layout.
FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS edge-build
ENV GOTOOLCHAIN=local CGO_ENABLED=0
WORKDIR /src
RUN wget -q https://codeload.github.com/caddyserver/caddy/tar.gz/87c43dc4f54861ec7e54302cfb2ad3e34508b6dc -O caddy.tar.gz \
 && echo 'bb250cdef3e4baad82af6c048ac9754b4d1350d50a55af7c34e8d1aa574a6211  caddy.tar.gz' | sha256sum -c - \
 && tar -xzf caddy.tar.gz --strip-components=1 \
 && rm caddy.tar.gz \
 && go get golang.org/x/crypto@v0.58.0 golang.org/x/net@v0.61.0 golang.org/x/sys@v0.49.0 golang.org/x/text@v0.43.0 golang.org/x/term@v0.47.0 golang.org/x/sync@v0.24.0 \
 && go build -trimpath -ldflags '-s -w -X github.com/caddyserver/caddy/v2.CustomVersion=v2.11.7-cofounder.20261023' -o /out/caddy ./cmd/caddy \
 && go version -m /out/caddy > /out/build-info.txt

# Official image metadata reviewed 2026-10-23; see docs/HETZNER_DEPLOYMENT.md.
FROM caddy:2.11.7-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f
# Internal high ports need no file capability or added runtime capability.
RUN setcap -r /usr/bin/caddy
COPY --from=edge-build /out/caddy /usr/bin/caddy
COPY --from=edge-build /out/build-info.txt /usr/share/caddy/build-info.txt
COPY deploy/hetzner/Caddyfile /etc/caddy/Caddyfile
RUN PUBLIC_HOSTNAME=cofounder.example.invalid caddy adapt --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null
USER 1000:1000
