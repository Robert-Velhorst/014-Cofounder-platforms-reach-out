{
  "name": "cofounder-outreach-workspace",
  "version": "2.0.0",
  "private": true,
  "description": "Production-safe co-founder discovery and assisted outreach workspace",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.13.0",
  "scripts": {
    "dev": "pnpm --dir apps/cofounder-discovery dev",
    "build": "pnpm --dir apps/cofounder-discovery build",
    "start": "pnpm --dir apps/cofounder-discovery start",
    "check": "pnpm --dir apps/cofounder-discovery check",
    "test": "pnpm test:release-contract && pnpm test:requirements && pnpm test:api-audit && pnpm test:ui-audit && pnpm test:budget && pnpm test:monitor && pnpm test:recovery && pnpm test:production-config && pnpm test:tunnel && pnpm test:support && pnpm test:release-inventory && pnpm --dir apps/cofounder-discovery test:unit",
    "test:integration": "pnpm --dir apps/cofounder-discovery test:integration",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:readiness:integration && pnpm test:recovery:integration && pnpm test:runtime-startup:integration && pnpm test:authentication-admission:integration",
    "db:migrate": "pnpm --dir apps/cofounder-discovery db:migrate",
    "doctor": "pnpm --dir apps/cofounder-discovery doctor",
    "verify": "pnpm --dir apps/cofounder-discovery verify",
    "test:ui-audit": "node --test scripts/ui-action-audit.test.mjs",
    "audit:ui": "node scripts/ui-action-audit.mjs",
    "test:api-audit": "node --test scripts/api-surface-audit.test.mjs",
    "audit:api": "node scripts/api-surface-audit.mjs",
    "test:tunnel": "node --test scripts/ngrok-launch.test.mjs",
    "test:release-inventory": "node --test scripts/release-inventory.test.mjs",
    "release:inventory": "node scripts/release-inventory.mjs",
    "test:support": "node --test scripts/support-bundle.test.mjs",
    "support:bundle": "node scripts/support-bundle.mjs",
    "test:requirements": "node --test scripts/goal-traceability.test.mjs",
    "requirements:check": "node scripts/goal-traceability.mjs",
    "test:release-contract": "node --test scripts/release-test-inventory.test.mjs",
    "test:budget": "node --test scripts/production-budget.test.mjs",
    "budget:check": "node scripts/production-budget.mjs",
    "test:monitor": "node --test scripts/production-monitor.test.mjs",
    "test:recovery": "node --test scripts/database-recovery.test.mjs",
    "test:production-config": "node --test scripts/production-config.test.mjs",
    "test:recovery:integration": "node --test scripts/database-recovery.integration.test.mjs",
    "test:authentication-admission:integration": "node --test scripts/authentication-admission.integration.test.mjs",
    "test:runtime-startup:integration": "node --test scripts/runtime-startup.integration.test.mjs",
    "test:readiness:integration": "node --test scripts/database-readiness.integration.test.mjs"
  }
}
