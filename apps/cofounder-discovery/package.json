{
  "name": "cofounder-discovery-platform",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js && esbuild scripts/migrate.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/migrate.js",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit",
    "test:unit": "cross-env NODE_ENV=test vitest run --exclude '**/*.integration.test.ts' --exclude 'server/autonomous-matching.test.ts' --exclude 'server/ai-monitoring.test.ts' --exclude 'server/phase22.test.ts' --exclude 'server/__tests__/profile-update.test.ts'",
    "test:integration": "cross-env NODE_ENV=test REQUIRE_DATABASE_TESTS=true vitest run server/critical-path.integration.test.ts server/autonomous-matching.test.ts server/ai-monitoring.test.ts server/phase22.test.ts server/__tests__/profile-update.test.ts",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "doctor": "tsx scripts/doctor.ts",
    "verify": "pnpm check && pnpm test:unit && pnpm build && pnpm doctor -- --allow-missing-runtime"
  },
