# Runtime identity
NODE_ENV=development
APP_MODE=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Required for database-backed features.
DATABASE_URL=mysql://cofounder:cofounder@127.0.0.1:3306/cofounder

# Migration runner only: bounded wait for another cooperating migrator (1-300s).
# Does not bound DDL duration or make schema changes automatically reversible.
MIGRATION_LOCK_TIMEOUT_SECONDS=60

# Packaged supervisor: apply (default) or verify. No skip mode.
# verify requires complete existing history and never applies pending SQL.
# It does not provision separate credentials or reduce the configured user's grants.
STARTUP_MIGRATION_MODE=apply
# Only with verify mode and an independently provisioned restricted runtime user.
# Refuses broad grants/roles; never changes grants or falls back to migration access.
# STARTUP_DATABASE_AUTHORITY=runtime-dml

# Generate a unique value with at least 32 characters. Never commit the value.
JWT_SECRET=

# Container-mounted secrets: the supported variables DATABASE_URL, JWT_SECRET,
# CREDENTIAL_ENCRYPTION_SECRET, AUTH_MAIL_ENCRYPTION_SECRET, RESEND_API_KEY and
# HAI_CONNECTOR_TOKEN may instead use NAME_FILE=/run/secrets/file_name.
# Leave the corresponding raw NAME unset/empty; conflicting sources fail closed.
# Single-line UTF-8 regular files, maximum 16 KiB; restart to apply changes.
# See docs/PRODUCTION_CONTAINER_RUNBOOK.md; never commit real secret files.

# Registration is explicit so hosted operators control account creation.
ENABLE_REGISTRATION=true

# Review-held intake only, not erasure. Enable only with an operator intake owner.
# Apply migration 0034 first; status and withdrawal remain available when paused.
ENABLE_ACCOUNT_DELETION_REQUESTS=false

# Per-process active API work: contexts, procedures, readiness and HAI feed.
# 0 pauses admission, not running work or mail workers. Range 0-1024; default 32.
# Not a fleet-wide rate limit or monetary cap. Changes require app restart.
API_MAX_ACTIVE_WORK=32

# Retained-row admission ceilings, not a guarantee about hosting cost or load.
# All app/worker instances must share these values. Zero pauses NEW records;
# existing data, opt-outs and validated retries remain available. Never delete
# suppression/source history merely to free capacity. Migrate through 0028 first.
CAPACITY_ACCOUNTS=100
# Retained sessions per account. Zero stops signup/new sign-ins, not existing sessions.
CAPACITY_SESSIONS_PER_ACCOUNT=10
CAPACITY_PROSPECTS_TOTAL=50000
CAPACITY_PROSPECTS_PER_ACCOUNT=1000
CAPACITY_OUTREACH_TOTAL=25000
CAPACITY_OUTREACH_PER_ACCOUNT=500
CAPACITY_WORKSPACE_AUDIT_TOTAL=100000
CAPACITY_WORKSPACE_AUDIT_PER_ACCOUNT=10000

# Required to verify new accounts. Configure a Resend key and a verified sender
# address. No email is simulated when these values are absent.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Independent 32+ character secret for encrypted recovery mail queue payloads.
AUTH_MAIL_ENCRYPTION_SECRET=
# Explicit opt-in to process queued recovery mail and change notices. Keep off
# until sender credentials and the independent encryption secret are configured.
# Full browser/inbox acceptance and retention remain public-beta release gates.
ENABLE_ACCOUNT_MAIL_WORKER=false
# Opt-in deletion of expired request quotas and old terminal mail metadata.
# Independent of sending; requires a UTC database session and migration 0029.
ENABLE_ACCOUNT_MAIL_RETENTION=false
# Shared verification/recovery/change-notice attempt ceilings (UTC calendar windows).
# Zero pauses new delivery attempts; these are not provider invoice limits.
ACCOUNT_MAIL_DAILY_ATTEMPTS=100
ACCOUNT_MAIL_MONTHLY_ATTEMPTS=1000

# Global safety stop. Research and review stay available when true, but send
# preparation is blocked.
OUTREACH_PAUSED=false

# Unsafe imported prototype routes and browser automation remain off. Do not
# enable without documented provider authorization, policy review, and a
# dedicated encryption key.
ENABLE_UNSAFE_LEGACY_ROUTES=false
ENABLE_PLATFORM_AUTOMATION=false
# Separate inherited provider route; keep disabled until recipient/terms/budget
# and content transfer are approved. Forge credentials alone never enable it.
ENABLE_OWNER_NOTIFICATIONS=false
CREDENTIAL_ENCRYPTION_SECRET=

# Only enable behind one trusted reverse proxy.
TRUST_PROXY=false

# Optional read-only HAI generic JSON feed. Both values are required together.
# Content is withheld by default; HAI still receives state/provenance metadata.
HAI_CONNECTOR_TOKEN=
HAI_CONNECTOR_USER_ID=
HAI_CONNECTOR_INCLUDE_CONTENT=false

# Optional connected-account OAuth. Assisted outreach does not need these.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
