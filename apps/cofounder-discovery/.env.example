# Required to run database-backed features and integration tests.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Required before platform credentials can be saved. Use a unique, high-entropy value.
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-long-random-secret

# Optional OAuth configuration; leave unset if OAuth is not enabled.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Browser-driven scraping and outreach are disabled by default. Enable only after
# verifying authorization and each target platform's Terms of Service.
ENABLE_PLATFORM_AUTOMATION=false
