{
	http_port 8080
	https_port 8443
	admin off
	persist_config off
	skip_install_trust
	servers {
		protocols h1 h2
		strict_sni_host on
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$PUBLIC_HOSTNAME} {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy app:3000 {
		lb_retries 0
		# This is the only ingress hop. Do not trust client forwarding claims.
		header_up -Forwarded
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}
